FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv
COPY . .
RUN pip install --no-cache-dir '.[dev]' && useradd --uid 10001 --create-home agent && chown -R agent:agent /srv
USER agent
CMD ["sh", "-c", "ruff check . && pytest -q && python scripts/smoke_api.py http://api:8080"]
