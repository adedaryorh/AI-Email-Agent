{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1, "newProjectRoot": "projects",
  "projects": {"email-agent": {"projectType": "application", "root": "", "sourceRoot": "src", "prefix": "app",
    "architect": {
      "build": {"builder": "@angular/build:application", "options": {"outputPath": "dist/email-agent", "index": "src/index.html", "browser": "src/main.ts", "tsConfig": "tsconfig.app.json", "assets": [{"glob": "**/*", "input": "public"}], "styles": ["src/styles.css"]},
        "configurations": {"production": {"budgets": [{"type": "initial", "maximumWarning": "650kB", "maximumError": "1MB"}], "outputHashing": "all"}, "development": {"optimization": false, "sourceMap": true}}, "defaultConfiguration": "production"},
      "serve": {"builder": "@angular/build:dev-server", "configurations": {"production": {"buildTarget": "email-agent:build:production"}, "development": {"buildTarget": "email-agent:build:development"}}, "defaultConfiguration": "development"}
    }
  }}
}