APP_ENV=dev
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/emailagent
# Generate all three with: python scripts/init_env.py (does not overwrite .env).
API_KEY=
SECRET_KEY=
ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/mailboxes/oauth/gmail/callback
LLM_MODEL=openai:gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Opt in after reading docs/privacy.md. A real LLM call is blocked until true.
ALLOW_CLOUD_PROCESSING=false
REDACT_PII=true
REVIEW_CONFIDENCE_THRESHOLD=0.7
SYNC_INITIAL_DAYS=7
POLL_INTERVAL_SECONDS=60
MAX_BODY_CHARS=6000
MAX_PROCESSING_ATTEMPTS=5
RETRY_BASE_SECONDS=30
API_REQUESTS_PER_MINUTE=120
RETENTION_DAYS=30
# Optional provider tracing is OFF by default; it can expose message contents.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-email-agent

# Browser login is separate from API_KEY. Run scripts/setup_login.py to set a hash.
BROWSER_USERNAME=admin
BROWSER_PASSWORD_HASH=
FRONTEND_ORIGIN=http://localhost:4200
SESSION_TTL_SECONDS=28800

# Bounded read-only draft agent. Maximum planner calls plus compose + verification.
AGENT_MAX_STEPS=4
AGENT_TIMEOUT_SECONDS=180
AGENT_MAX_INPUT_CHARS=120000
AGENT_MAX_OUTPUT_TOKENS=2048
# Optional estimated USD accounting/guard. Supply your model's current rates.
# LLM_INPUT_USD_PER_MILLION=...
# LLM_OUTPUT_USD_PER_MILLION=...
# AGENT_MAX_COST_USD=0.25
